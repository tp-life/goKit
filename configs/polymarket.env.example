# 复制本文件为 `configs/polymarket.env` 后即可生效。
# 如果你只需要监控，保持 AUTO_TRADE=false / AUTO_REDEEM=false 即可。

POLYMARKET_ENABLED=true
POLYMARKET_PROXY_URL=
# 界面模式: web / tui / both
POLYMARKET_UI_MODE=tui
# TUI 刷新间隔，单位毫秒
POLYMARKET_TUI_REFRESH_INTERVAL_MS=1000
# 例如:
# POLYMARKET_PROXY_URL=http://127.0.0.1:7890
# POLYMARKET_PROXY_URL=socks5://127.0.0.1:7891

# 市场配置
# 推荐直接使用 watchlist 配置多个市场，格式:
# POLYMARKET_MARKETS=BTC:15m,ETH:15m,SOL:5m
# 单市场也可以写成:
# POLYMARKET_MARKETS=BTC:15m
# 旧版单市场配置仍兼容，但在配置了 POLYMARKET_MARKETS 后会被 watchlist 覆盖。
POLYMARKET_MARKETS=BTC:15m

# 旧版兼容字段
POLYMARKET_MARKET_SYMBOL=BTC
POLYMARKET_MARKET_INTERVAL_SEC=900

# 监控模式
AUTO_TRADE=false
AUTO_REDEEM=true
AUTO_REDEEM_HOUR_LOCAL=3
AUTO_REDEEM_MAX_RETRY=2
AUTO_REDEEM_RETRY_DELAY_SEC=15
AUTO_REDEEM_MAX_PER_RUN=5
AUTO_REDEEM_RECEIPT_TIMEOUT_SEC=90
# 跳过极小的尘埃兑奖仓位；设为 0 可关闭该过滤。
AUTO_REDEEM_MIN_SIZE=0.01

# 可选: 开启实盘后再填写
# PRIVATE_KEY=
# 如果你已经在 Polymarket 后台创建了固定的 CLOB API 凭证，也可以显式配置下面三项；
# 不填写时，程序会继续使用 PRIVATE_KEY 自动创建/派生 API key。
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# 代理钱包 / Safe 的自动兑奖需要额外配置 relayer 鉴权。
# 二选一即可:
# 1. Builder Program 凭证
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# 2. Relayer API Key
# POLYMARKET_RELAYER_API_KEY=
# POLYMARKET_RELAYER_API_KEY_ADDRESS=
# FUNDER_ADDRESS=
# SIGNATURE_TYPE 签名类型:
# 0=EOA
# 1=POLY_PROXY
# 2=GNOSIS_SAFE
# 如果你是从 Polymarket 页面导出私钥并使用代理钱包持仓，通常应设置为 1。
# SIGNATURE_TYPE=1
# POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# 基础路径
POLYMARKET_STATE_FILE=data/polymarket/state.json
POLYMARKET_DASHBOARD_STATIC_DIR=web/polymarket

# Polymarket / Binance 数据源
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CRYPTO_PRICE_API=https://polymarket.com/api/crypto/crypto-price
POLYMARKET_CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_WS=wss://ws-live-data.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_PRICE_URL=https://api.binance.com/api/v3/ticker/price

# 运行节奏
LOOP_INTERVAL_SEC=0.25
MARKET_META_REFRESH_SEC=5
PRICE_REFRESH_SEC=5
MARKET_DATA_MAX_LAG_SEC=1.2

# 交易策略默认值
TRADE_AMOUNT=5
ORDER_TIMEOUT_SEC=8
SLIPPAGE_THRESHOLD=0.05
MAX_RETRY_PER_MARKET=2
BUY_RETRY_STEP=0.01

# 止损配置
# 含义: 以入场概率为基准的相对回撤比例。
# 例如入场概率 0.80，配置 0.15，则止损概率约为 0.68。
STOP_LOSS_PROB_PCT=0.15

# 止盈配置
TAKE_PROFIT_RR=1.0
TAKE_PROFIT_CAP=0.99
TAKE_PROFIT_RETRY_STEP=0.005
TAKE_PROFIT_RETRY_MAX=3

# 自动交易条件
# 说明:
# 1. CONDITION_*_DIFF 仍表示旧版绝对价差，主要兼容 BTC 单市场配置。
# 2. CONDITION_*_DIFF_BPS 表示相对价差阈值，单位 bps；大于 0 时会优先生效。
# 3. 多市场同时监控时，优先推荐使用 *_DIFF_BPS，这样 BTC / ETH / SOL 可以共用一套规则。
CONDITION_1_TIME=120
CONDITION_1_DIFF=30
CONDITION_1_DIFF_BPS=3
CONDITION_1_MIN_PROB=0.80
CONDITION_1_MAX_PROB=0.92

CONDITION_2_TIME=120
CONDITION_2_DIFF=30
CONDITION_2_DIFF_BPS=3
CONDITION_2_MIN_PROB=0.80
CONDITION_2_MAX_PROB=0.92

CONDITION_3_TIME=60
CONDITION_3_DIFF=50
CONDITION_3_DIFF_BPS=5
CONDITION_3_MIN_PROB=0.80
CONDITION_3_MAX_PROB=0.92

CONDITION_4_TIME=60
CONDITION_4_DIFF=50
CONDITION_4_DIFF_BPS=5
CONDITION_4_MIN_PROB=0.80
CONDITION_4_MAX_PROB=0.92
