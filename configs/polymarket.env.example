# 复制本文件为 `configs/polymarket.env` 后即可生效。
# 如果你只需要监控，保持 AUTO_TRADE=false / AUTO_REDEEM=false 即可。

POLYMARKET_ENABLED=true
POLYMARKET_PROXY_URL=
# 界面模式: web / tui / both
POLYMARKET_UI_MODE=tui
# TUI 刷新间隔，单位毫秒
POLYMARKET_TUI_REFRESH_INTERVAL_MS=1000
# 例如:
# POLYMARKET_PROXY_URL=http://127.0.0.1:7890
# POLYMARKET_PROXY_URL=socks5://127.0.0.1:7891

# 市场配置
# 推荐直接使用 watchlist 配置多个市场，格式:
# POLYMARKET_MARKETS=BTC:15m,ETH:15m,SOL:5m
# 单市场也可以写成:
# POLYMARKET_MARKETS=BTC:15m
# 旧版单市场配置仍兼容，但在配置了 POLYMARKET_MARKETS 后会被 watchlist 覆盖。
POLYMARKET_MARKETS=BTC:15m

# 旧版兼容字段
POLYMARKET_MARKET_SYMBOL=BTC
POLYMARKET_MARKET_INTERVAL_SEC=900

# 监控模式
AUTO_TRADE=false
AUTO_REDEEM=true
AUTO_REDEEM_HOUR_LOCAL=3
AUTO_REDEEM_MAX_RETRY=2
AUTO_REDEEM_RETRY_DELAY_SEC=15
AUTO_REDEEM_MAX_PER_RUN=5
AUTO_REDEEM_RECEIPT_TIMEOUT_SEC=90
# 跳过极小的尘埃兑奖仓位；设为 0 可关闭该过滤。
AUTO_REDEEM_MIN_SIZE=0.01

# 可选: 开启实盘后再填写
# PRIVATE_KEY=
# 如果你已经在 Polymarket 后台创建了固定的 CLOB API 凭证，也可以显式配置下面三项；
# 不填写时，程序会继续使用 PRIVATE_KEY 自动创建/派生 API key。
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# 代理钱包 / Safe 的自动兑奖需要额外配置 relayer 鉴权。
# 二选一即可:
# 1. Builder Program 凭证
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# 2. Relayer API Key
# POLYMARKET_RELAYER_API_KEY=
# POLYMARKET_RELAYER_API_KEY_ADDRESS=
# FUNDER_ADDRESS=
# SIGNATURE_TYPE 签名类型:
# 0=EOA
# 1=POLY_PROXY
# 2=GNOSIS_SAFE
# 如果你是从 Polymarket 页面导出私钥并使用代理钱包持仓，通常应设置为 1。
# SIGNATURE_TYPE=1
# POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# 基础路径
POLYMARKET_STATE_FILE=data/polymarket/state.json
POLYMARKET_DASHBOARD_STATIC_DIR=web/polymarket

# Polymarket / Binance 数据源
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CRYPTO_PRICE_API=https://polymarket.com/api/crypto/crypto-price
POLYMARKET_CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_WS=wss://ws-live-data.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_PRICE_URL=https://api.binance.com/api/v3/ticker/price

# 运行节奏
LOOP_INTERVAL_SEC=0.25
MARKET_META_REFRESH_SEC=5
PRICE_REFRESH_SEC=5
MARKET_DATA_MAX_LAG_SEC=1.2

# 交易策略默认值
TRADE_AMOUNT=5
ORDER_TIMEOUT_SEC=8
SLIPPAGE_THRESHOLD=0.05
# 同一信号需要连续成立多久后才允许下单；设为 0 表示关闭确认。
AUTO_TRADE_CONFIRM_SEC=2
# 要求信号在扣除点差、滑点与预估 taker 成本后，至少还剩多少 bps 的净边际。
MIN_NET_EDGE_BPS=1.5
# 自动交易是否优先尝试 post-only maker 入场。
AUTO_TRADE_PREFER_POST_ONLY=true
# maker 入场默认使用 GTD，给它保留的额外有效期秒数。
AUTO_TRADE_POST_ONLY_TTL_SEC=2
# 是否根据最近策略收益自动缩放自动下单金额。
AUTO_SIZE_BY_PERFORMANCE=true
# 动态调仓位回看最近多少笔闭环交易。
AUTO_SIZE_LOOKBACK_TRADES=6
# 至少累计多少笔闭环交易后才开始调仓位。
AUTO_SIZE_MIN_TRADES=3
# 表现较差时最小只缩到基础仓位的多少倍。
AUTO_SIZE_MIN_MULTIPLIER=0.5
# 表现较好时最多放大到基础仓位的多少倍。
AUTO_SIZE_MAX_MULTIPLIER=1.5
MAX_RETRY_PER_MARKET=2
BUY_RETRY_STEP=0.01
# 是否要求 Binance 方向也与 Chainlink/PTB 主信号一致。
BINANCE_REQUIRE_ALIGNMENT=true
# Binance 方向确认至少需要达到的 bps 幅度；设为 0 时只要求方向一致。
BINANCE_CONFIRM_MIN_DIFF_BPS=1.5
# Chainlink 与 Binance 偏差超过该值时直接放弃本次开仓。
BINANCE_VETO_MAX_DEVIATION_BPS=8

# 全局风控
# 0 表示关闭该条限制。
MAX_CONCURRENT_MARKETS=1
MAX_TOTAL_OPEN_NOTIONAL=10
MAX_SAME_SIDE_MARKETS=1
LOSS_STREAK_LIMIT=3
LOSS_STREAK_COOLDOWN_MIN=120
# 是否按最近闭环交易自动停用持续亏损的策略桶。
AUTO_DISABLE_NEGATIVE_STRATEGIES=true
# 自动停用时回看最近多少笔闭环交易。
AUTO_DISABLE_LOOKBACK_TRADES=4
# 最近 lookback 笔总收益低于该阈值时停用；例如 -0.5 表示亏损超过 0.5 USDC 才停。
AUTO_DISABLE_MIN_TOTAL_PNL=-0.5

# 止损配置
# 含义: 以入场概率为基准的相对回撤比例。
# 例如入场概率 0.80，配置 0.15，则止损概率约为 0.68。
STOP_LOSS_PROB_PCT=0.15
# 最后 N 秒若强信号仍成立，可暂缓止损直接观察到结算；设为 0 表示关闭。
STOP_LOSS_HOLD_FINAL_SEC=0
# 启用尾盘止损保护时，要求外部参考价与 PTB 的最小偏离强度，单位 bps。
STOP_LOSS_HOLD_MIN_DIFF_BPS=8
# 是否要求 Binance 也与持仓方向同向，才允许尾盘豁免止损。
STOP_LOSS_HOLD_REQUIRE_BINANCE_ALIGNMENT=true
# 尾盘止损保护要求的最大参考价延迟，单位秒。
STOP_LOSS_HOLD_MAX_LAG_SEC=1.0

# 止盈配置
TAKE_PROFIT_RR=1.0
TAKE_PROFIT_CAP=0.99
TAKE_PROFIT_RETRY_STEP=0.005
TAKE_PROFIT_RETRY_MAX=3

# 自动交易条件
# 说明:
# 1. CONDITION_* 现在表示 4 个“通用档位”，默认按参考价差正负自动决定买 UP 或 DOWN。
# 2. 程序会按 TIME 从近到远自动排序，编号只作为档位标签，不会因为 4 的时间大于 1 就失效。
# 3. CONDITION_*_DIFF_BPS 表示相对价差阈值，单位 bps。
CONDITION_1_TIME=120
CONDITION_1_DIFF_BPS=5
CONDITION_1_MIN_PROB=0.80
CONDITION_1_MAX_PROB=0.92

CONDITION_2_TIME=120
CONDITION_2_DIFF_BPS=5
CONDITION_2_MIN_PROB=0.80
CONDITION_2_MAX_PROB=0.92

CONDITION_3_TIME=60
CONDITION_3_DIFF_BPS=8
CONDITION_3_MIN_PROB=0.80
CONDITION_3_MAX_PROB=0.92

CONDITION_4_TIME=60
CONDITION_4_DIFF_BPS=8
CONDITION_4_MIN_PROB=0.80
CONDITION_4_MAX_PROB=0.92

# 市场级覆盖示例
# 说明:
# 1. 前缀格式为 `MARKET_<SYMBOL>_<INTERVAL>_`，例如 `MARKET_BTC_15M_`。
# 2. 可以只覆盖少数几个字段，其余仍然继承全局默认值。
# 3. 把某个条件的 TIME 设为 0，等价于关闭该条件。
# MARKET_BTC_15M_AUTO_TRADE_CONFIRM_SEC=2
# MARKET_BTC_15M_CONDITION_1_DIFF_BPS=5
# MARKET_BTC_15M_CONDITION_3_TIME=0
# MARKET_ETH_15M_TRADE_AMOUNT=3
# MARKET_ETH_15M_CONDITION_1_DIFF_BPS=6
# MARKET_ETH_15M_BINANCE_CONFIRM_MIN_DIFF_BPS=2
# MARKET_SOL_5M_TRADE_AMOUNT=2
# MARKET_SOL_5M_CONDITION_1_DIFF_BPS=8
# MARKET_SOL_5M_CONDITION_3_TIME=0
