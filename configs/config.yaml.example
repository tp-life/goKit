app:
  name: "my-high-perf-service"
  version: "v1.0.0"

web:
  port: ":8080"
  app_name: "MyAPI"
  prefork: false

rpc:
  port: ":9090"
  max_connection_idle: 300s
  timeout: 5s

database:
  driver: "mysql"
  # 请修改为你的实际数据库地址
  dsn: "root:root@tcp(127.0.0.1:3306)/my_db?charset=utf8mb4&parseTime=True&loc=Local"
  replicas: []
  max_idle_conns: 10
  max_open_conns: 100
  log_mode: "info"
  # 启动时自动迁移 sys_* 表结构（简单部署用，生产建议关闭）
  auto_migrate: true

jwt:
  # 生产环境务必修改为强随机值；微服务模式下所有服务必须共享同一 secret
  secret: "please-change-me-in-production"
  issuer: "gokit"
  expire_minutes: 120

authz:
  # local  → 单机模式：进程内直接校验权限（默认）
  # remote → 微服务模式：通过 gRPC 调用系统服务做权限校验
  mode: "local"
  # remote 模式下系统服务的 gRPC 地址
  addr: "127.0.0.1:9090"
  # 服务间共享密钥：非空时系统服务 gRPC 启用 Bearer 认证，
  # 业务服务的远程客户端必须携带同一 token；留空表示不启用（仅限内网可信环境）
  token: ""

seed:
  # 首次启动播种 admin 账号 / 内置角色 / 菜单权限树（admin 已存在则跳过）
  enabled: true
