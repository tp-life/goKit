app:
  # 服务名（用于日志/展示）。
  name: "funding-arbitrage-monitor"
  # 服务版本号（用于排障与前后端兼容确认）。
  version: "v2.0.0"
  # 全局调试开关（true 时建议配合更详细日志级别使用）。
  debug: false

web:
  # HTTP 服务监听地址。
  port: ":8080"
  # Web 页面展示的应用名称。
  app_name: "Funding Arbitrage Monitor"
  # Fiber prefork 开关（多进程模式，通常本地开发保持 false）。
  prefork: false
  # 保护开平仓 / 订单事件注入接口的 Bearer Token 环境变量名。
  execution_api_token_env: "EXECUTION_API_TOKEN"

rpc:
  # gRPC 服务监听地址。
  port: ":9090"
  # gRPC 连接最大空闲时间。
  max_connection_idle: 300s
  # gRPC 请求超时时间。
  timeout: 5s

database:
  # 数据库驱动。
  driver: "sqlite"
  # 数据库连接串（sqlite 下为文件路径）。
  dsn: "data/arbitrage.db"
  # 空闲连接池大小。
  max_idle_conns: 2
  # 最大打开连接数。
  max_open_conns: 4
  # ORM 日志级别（silent/error/warn/info）。
  log_mode: "error"
  # 慢 SQL 阈值。
  slow_threshold: 200ms

log:
  # 日志级别（debug/info/warn/error）。
  level: "info"
  # 日志格式（json/text）。
  format: "json"
  # 是否在日志中附带源码位置。
  source: false

strategy:
  # 策略总开关（false 时仅服务启动，不跑策略循环）。
  enabled: true
  # 策略模式：
  # - legacy_projection: 当前仓库主链里的“候选窗口累计 + 选主窗口”模式
  # - rolling_cycle_aligned: 按结算段滚动 review / 续持 / 翻仓的目标模式
  #
  # 当前这份示例按 rolling 设计组织配置；
  # 代码里已有兼容桥，会把新配置层映射回现有运行时字段。
  mode: "rolling_cycle_aligned"
  # 套利模式：
  # - cross_exchange: 现有默认模式，做跨交易所 funding 套利
  # - same_exchange_spot_perp: 新模式，只做同一 arbitrage_group 下的现货多 + 永续空
  arbitrage_mode: "same_exchange_spot_perp"

  universe:
    # 统一使用 canonical symbol（基础币）做监控范围。
    # Binance / Aster 的 BTCUSDT、Hyperliquid 的 BTC 最终都会映射到 BTC。
    allowed_symbols: ["BTC", "ETH", "SOL", "BNB", "XRP", "DOGE", "ADA", "LINK", "AVAX", "LTC"]
    # 核心币常驻深扫池，适合 BTC / ETH / SOL 这类“不想错过”的币。
    core_symbols: ["BTC", "ETH", "SOL"]
    # 报价资产过滤（例如 USDT）。
    quote_asset: "USDT"

  capital:
    # 总资金（USDT），用于推导可分配名义资金。
    total_capital_usdt: 1000
    # 资金利用率（0~1）。
    capital_utilization: 0.8
    # 目标杠杆。
    # 注意：same_exchange_spot_perp 模式下，effective_notional 默认按
    # total_capital_usdt * capital_utilization 计算，不再额外乘 leverage，
    # 因为现货腿本身需要全额占资；这里主要用于永续空单那一腿的保证金口径。
    leverage: 2
    # 假设名义价值（当无法从资金*杠杆推导时的兜底值）。
    assumed_notional: 1600

  opportunity:
    # 允许往后看的最大持有窗口（小时）。
    # rolling 模式下它主要决定“机会视角最多往后看多远”，不是固定最终持有到多久。
    # 如果持有模式改成 dynamic_profit，则不会再用它截断 legacy 候选窗口。
    hold_hours: 24
    # 兼容当前 legacy 主链的主窗口选择模式。
    # - latest_profitable: 在 hold_hours 内尽量选更晚且仍过门槛的窗口
    # - dynamic_profit: 不受 hold_hours 截断，按收益自动搜索更优兑现点
    # rolling 逻辑真正落地前，兼容桥会使用这个字段回退到旧行为。
    legacy_hold_selection_mode: "dynamic_profit"
    # 扣除手续费/滑点/安全垫后的最小净收益门槛（USDT）。
    min_net_pnl: 1.5
    # 前端展示机会数量上限（仅展示层建议值，非核心计算截断）。
    max_displayed_opportunities: 20

  execution_cost:
    # 开平仓总滑点假设（bps），会从预期收益中直接扣除。
    slippage_bps: 2
    # 额外安全垫（USDT），用于覆盖模型外误差。
    safety_buffer_usdt: 0.2
    # 入场下单模式（maker/taker/mixed）。
    entry_mode: "taker"
    # 出场下单模式（maker/taker/mixed）。
    exit_mode: "taker"

  market_data:
    # 行情最大允许延迟（超过则判为 stale）。
    max_data_age: 15s
    # funding 快照落库周期。
    funding_snapshot_persist_interval: 60s
    # 盘口 top 快照落库周期。
    book_snapshot_persist_interval: 20s
    # 快照保留时长（超出后清理）。
    snapshot_retention: 168h
    # 机会计算循环周期。
    opportunity_calc_interval: 5s
    # 盘口快照最小价格变化阈值（bps），低于该值可不落库。
    book_snapshot_min_price_change_bps: 0.5
    # 盘口快照最小数量变化比例，低于该值可不落库。
    book_snapshot_min_qty_change_ratio: 0.05

  spread_guard:
    # 跨所 basis 基础阈值（bps）。
    # 注意：实际可用阈值会按持有时长做动态放宽。
    max_spread_bps: 12
    # 动态阈值最大放大倍数：最终阈值不会超过 max_spread_bps * 该倍数。
    dynamic_max_spread_multiplier: 1.5
    # 动态阈值参考持有时长（小时）：funding_window_hours 达到该值时放大到上限。
    dynamic_max_spread_reference_hours: 24
    # 开仓窗口上边界：距离 required_entry_by 最多提前多久允许开仓。
    entry_lead_time: 180s
    # 开仓窗口下边界：距离 required_entry_by 少于该时间则停止开仓。
    entry_cutoff_time: 45s

  prediction:
    # funding 平滑估算的历史回看窗口。
    # 当前主要给 legacy_projection 使用；rolling_cycle_aligned 的机会识别已改成 real-only。
    funding_history_lookback: 6h
    # 真实 funding 历史事件的统计窗口。建议至少覆盖数天，否则 8h 结算币种样本会偏少。
    funding_rate_history_lookback: 720h
    # 启动回补 + 周期性同步交易所真实 funding 历史事件的间隔。
    funding_rate_history_sync_interval: 30m
    # 当前 funding 快照在平滑估算中的权重（0~1）。
    # rolling real-only 模式下，这个参数不会再影响“当前是否是机会”的主 carry。
    funding_smoothing_current_weight: 0.7
    # 对同一腿未来第2次及以后 funding 的费率衰减系数。
    # 当前 rolling 机会识别不再使用这类未来外推，只保留给 legacy_projection 或兼容链路。
    funding_rate_continuation_decay: 0.6
    # 兼容开关：rolling real-only 机会识别当前忽略这个设置，不再把中间预测段算进收益。
    allow_intermediate_forecast_before_boundary: true
    # 兼容开关：rolling real-only 机会识别当前天然满足这个约束。
    forbid_boundary_forecast: true

  same_exchange:
    entry:
      # 是否要求“粗略年化净收益 + 历史支持比例”同时过线，才允许把机会视为可开仓/可长期持有。
      require_long_hold_eligible: true
      # 长期持有评估要求的最少历史 funding 样本数。
      min_history_sample_count: 10
      # 当前 funding 同方向的历史支持比例门槛。
      # 例如当前 funding 为正，则使用“历史正费率占比”来判断它是否具备持续性。
      min_historical_support_ratio: 0.55
      # 基于“当前 funding * 同向支持比例 + 历史均值回归”的粗略年化净收益门槛。
      min_annualized_net_rate: 0.15
      # funding 持有窗口达到该时长后，基差不再只看硬阈值，而是改按“几轮 funding 才能覆盖基差+摩擦成本”判断。
      basis_long_hold_window_hours: 12
      # 长持模式下，若“覆盖基差+摩擦成本”需要的 funding 轮数超过该值，则标记为回本偏慢并优先降仓。
      max_basis_payback_events: 4
    exit:
      # 同所 spot-perp 模式下，若永续 funding 转负，是否触发一轮提前离场评估。
      close_on_negative_funding: true
      # 只有当历史 funding 中至少这么高比例为负时，当前 funding 转负才会触发这条离场逻辑。
      history_negative_ratio_threshold: 0.5
      # 是否要求“按当前盘口估算的平仓净值”仍为正，才执行这条提前离场。
      require_positive_close_pnl: true
      # 提前离场要求的最低估算平仓盈利（USDT）。
      min_close_pnl: 0.5
    risk:
      # 同所现货对冲模式下，永续空头允许使用的最大杠杆。
      max_perp_leverage: 1.5
      # 若账户上已经存在同 symbol 永续持仓，且离 liquidation 太近，则拒绝继续加仓/开仓。
      min_liq_distance_ratio: 0.12
      # 仅作为风险分层参考的“预警区”阈值。
      warn_liq_distance_ratio: 0.20
      # 持仓中的永续空头距离 liquidation 进入该区间时，直接触发保护性离场。
      reduce_liq_distance_ratio: 0.10
      # 更靠近 liquidation 的紧急阈值，命中后立即优先平仓。
      emergency_liq_distance_ratio: 0.08
      # 最近 1 小时内永续标记价若单边上冲超过该比例，则拒绝开仓并在持仓中触发保护性离场。
      max_1h_price_shock_ratio: 0.08
      # 当前 funding 若处于历史极高分位，同时历史负费率占比又偏高，则自动缩小仓位。
      funding_extreme_percentile: 0.95
      extreme_funding_negative_ratio: 0.50
      # 命中“高 funding 但历史易反转”的拥挤风险时，目标仓位缩放系数。
      extreme_funding_size_multiplier: 0.50
      # 长持模式下，若基差回本轮数已经偏高但尚未到拒绝阈值，则先缩小仓位。
      extreme_basis_payback_events: 2.5
      extreme_basis_size_multiplier: 0.65

  rolling:
    # EntryPath 是否只保留“方向连续一致”的 segment 前缀。
    entry_path_require_consistent_direction: true
    # 兼容字段：rolling 机会识别现在是 real-only，不再生成 single_forecast segment。
    # 暂时保留这个字段，主要是为了兼容旧配置和历史文档。
    max_single_exchange_forecast_segments: 0
    # 兼容字段：当前 rolling 机会识别忽略这些预测护栏；review/结构仍保留 rolling 语义。
    allow_intermediate_forecast_before_boundary: true
    forbid_boundary_forecast: true
    review:
      # 到 review 点后，为 funding 入账和边界抖动预留的短缓冲。
      settle_grace_period: 15s
      # 到达 review 点后，最多等待多久让最新 funding 快照刷新到内存。
      fresh_snapshot_max_wait: 20s
      # 若超时仍没有 fresh snapshot，是否保守平仓。
      close_on_snapshot_timeout: true
      # 若新一轮方向与当前持仓一致，是否允许继续持有。
      continue_on_same_direction: true
      # 若从当前 review 点往后看已无正向收益，是否直接平仓。
      close_on_unprofitable: true
      # 续持时是否要求“从现在开始的增量净收益”仍为正。
      require_incremental_net_positive: true
      # 续持的最小增量净收益门槛（USDT）；0 表示只要求 > 0。
      min_incremental_net_pnl: 0
    flip:
      # shared segment 到来且方向反向时，是否允许 close -> open successor。
      enabled: true
      # 是否要求翻仓后的净收益为正且过门槛。
      require_net_positive: true
      # 翻仓最小净收益门槛（USDT）。
      min_net_pnl: 1.5
      # 翻仓额外滑点乘子，用于覆盖“平旧仓 + 开新仓”的额外摩擦。
      slippage_multiplier: 1.5
      # 翻仓额外安全垫（USDT）。
      extra_safety_buffer_usdt: 0.2

  scan:
    # 全市场 funding 粗筛后，最多挑多少个 symbol 进入动态深扫池。
    # =0 表示不设上限，所有 funding 候选都允许进入深扫池。
    dynamic_candidate_limit: 30
    # 每轮额外抽多少个“没进 TopN 的币”做冷门轮转补扫；=0 表示关闭轮转。
    rotation_batch_size: 25
    # 多久重算一次深扫池。
    rotation_interval: 30s
    # 某个 symbol 一旦进入深扫池，至少保留这么久，避免 websocket 频繁抖动。
    deep_scan_hold_duration: 3m

  execution:
    # true = 允许真实下单；false = 仅做 dry-run 记录，不会向交易所发单。
    enabled: false
    # 是否自动开仓。
    auto_entry: true
    # 是否自动平仓。
    auto_close: true
    # 兼容当前执行链使用的“计划性平仓缓冲”。
    # rolling 模式建议与 strategy.rolling.review.settle_grace_period 保持一致。
    close_grace_period: 15s
    # 执行引擎轮询周期。
    loop_interval: 3s
    # 每轮最多读取多少条最新执行计划/记录。
    # 这只是“候选读取上限”，不是“最多实际开几单”。
    max_latest_plans: 50
    # 自动开仓时，是否把“剩余可用 notional”按本轮可开 plan 数动态平分。
    # false = 保持旧行为，每条 plan 都按完整目标仓位尝试开仓。
    auto_allocate_capital: false
    # 同时最多允许多少条 live execution 存在。
    # =0 表示不限制；opened / pending / recovery close 都计入。
    max_live_plans: 0
    # 每轮自动开仓循环最多尝试推进多少条新 plan。
    # =0 表示不限制，仍受 max_latest_plans 与 max_live_plans 共同约束。
    max_auto_open_per_loop: 0
    # 持仓期间允许承受的最大“按当前可成交方向估算”的浮亏（USDT）。
    # latest_profitable 模式下，若你想尽量持有到目标 funding 窗口，建议先保持 0；
    # 如果你想保留异常行情止损，再逐步调到 8~10 这类更宽的阈值。
    max_unrealized_loss_usdt: 0
    # 若当前解仓方向的跨所 basis 恶化超过该阈值（bps），则提前触发自动平仓。
    # latest_profitable 模式下，若你想减少“尚未到目标结算点就被提前平掉”的概率，建议先保持 0。
    max_unwind_basis_bps: 0
    # 持仓期间的紧急可用余额比例下限。
    # 例如设为 0.05 表示 available_balance / equity 低于 5% 时提前平仓。
    # latest_profitable 模式下，若当前资金缓冲足够，也建议先保持 0，避免常规持有被提前打断。
    emergency_min_available_balance_ratio: 0
    # 每条主腿从发请求到拿到同步结果，最多允许等待多久。
    # 超时后系统不会无限卡住，而会立刻用 client_order_id 做 best-effort 查单/查仓。
    # =0 表示不额外加这层腿级超时。
    primary_leg_timeout: 0
    position_monitor:
      # 运行中若检测到只剩单腿暴露，是否立即触发 reduce-only 收口。
      force_close_on_single_leg: true
      # 运行中若检测到某条腿方向与预期相反，是否立即触发收口。
      force_close_on_side_mismatch: true
      # 运行中若检测到某条腿数量明显偏离计划对冲规模，是否立即触发收口。
      force_close_on_size_mismatch: true
      # 数量漂移容忍比例；例如 0.15 表示偏离 15% 以内仍视为可接受。
      max_qty_deviation_ratio: 0.15
    replacement:
      # 是否启用“更优机会出现时主动换仓”。
      enabled: true
      # 仅在 live slot 或总预算已经吃满时才考虑换仓。
      only_when_constrained: true
      # 是否要求“扣完当前平仓成本后”的净增益仍然过门槛。
      require_net_improvement: true
      # 主动换仓最小净增益门槛（USDT）。
      min_net_improvement_pnl: 1.5
      # 主动换仓额外安全垫（USDT），用于覆盖平旧仓时的额外摩擦。
      extra_safety_buffer_usdt: 0.2

exchanges:
  binance:
    # 该交易所实例复用哪类接入协议族。
    # 当前这份实现并不是“通用 CEX”，而是 Binance Futures 风格协议族。
    adapter_kind: "binance_like"
    # 某些协议族（例如 OKX 一类）还可能使用：
    # - auth.passphrase_env
    # - auth.extra_env
    # - adapter_options
    # 该交易所实例在策略层复用哪类 venue 规则画像；
    # 为空时会优先按交易所名匹配，再按 adapter_kind 推断。
    venue_kind: "binance"
    # 交易所适配器开关。
    enabled: true
    # 展示名称。
    label: "Binance"
    # 同所套利分组；只有同一个 arbitrage_group 下的 spot/perp 才会被 same_exchange_spot_perp 模式配对。
    arbitrage_group: "binance"
    # 结算资产（用于跨所比较与风险提示）。
    settle_asset: "USDT"
    # REST API 基地址。
    rest_base_url: "https://fapi.binance.com"
    # 行情 WS 基地址（市场数据）。
    market_ws_base_url: "wss://fstream.binance.com"
    # 公共 WS 基地址（交易/订阅可能复用）。
    public_ws_base_url: "wss://fstream.binance.com"
    # 私有订单/用户流 WS 基地址。
    private_ws_base_url: "wss://fstream.binance.com"
    # 请求超时。
    request_timeout: 10s
    # 默认 funding 周期（小时），当接口未返回时兜底。
    default_funding_interval_hours: 8
    proxy:
      # 是否启用 HTTP 代理。
      enabled: false
      # 代理地址。
      url: "http://127.0.0.1:7890"
    fees:
      # Maker 手续费（bps）。
      maker_bps: 2.0
      # Taker 手续费（bps）。
      taker_bps: 5.0
    auth:
      # API Key 的环境变量名。
      api_key_env: "BINANCE_API_KEY"
      # API Secret 的环境变量名。
      api_secret_env: "BINANCE_API_SECRET"
      # RSA 模式使用的私钥环境变量名（推荐 PKCS#8 PEM）。
      # private_key_env: "BINANCE_RSA_PRIVATE_KEY"
    adapter_options:
      # Binance 当前支持 legacy_hmac 与 rsa 两种私有鉴权方式。
      # 若只配置了 private_key_env 且未提供 api_secret_env，程序会自动推断为 rsa。
      # trade_auth_mode: "legacy_hmac"
      # trade_auth_mode: "rsa"

  # 如需启用“同一交易所现货 + 永续空单”模式，可额外配置一个 Binance Spot 逻辑实例，
  # 并与上面的 Binance Futures 共用同一个 arbitrage_group。
  #
  # 使用方式：
  # 1. strategy.arbitrage_mode 改成 same_exchange_spot_perp
  # 2. 打开下面的 binance_spot.enabled
  # 3. 保持 binance.enabled=true，系统就会只配对 binance_spot + binance
  binance_spot:
    adapter_kind: "binance_spot"
    venue_kind: "binance"
    enabled: false
    label: "Binance Spot"
    arbitrage_group: "binance"
    settle_asset: "USDT"
    rest_base_url: "https://api.binance.com"
    request_timeout: 10s
    proxy:
      enabled: false
      url: "http://127.0.0.1:7890"
    fees:
      maker_bps: 1.0
      taker_bps: 1.0
    auth:
      # 若同一个 Binance key 同时具备 spot/futures 权限，可以直接复用同一组环境变量。
      api_key_env: "BINANCE_API_KEY"
      api_secret_env: "BINANCE_API_SECRET"
      # private_key_env: "BINANCE_RSA_PRIVATE_KEY"
    adapter_options:
      # trade_auth_mode: "legacy_hmac"
      # trade_auth_mode: "rsa"

  aster:
    adapter_kind: "binance_like"
    venue_kind: "aster"
    enabled: true
    label: "Aster"
    settle_asset: "USDT"
    rest_base_url: "https://fapi.asterdex.com"
    market_ws_base_url: "wss://fstream.asterdex.com"
    public_ws_base_url: "wss://fstream.asterdex.com"
    request_timeout: 10s
    default_funding_interval_hours: 8
    proxy:
      enabled: false
      url: "http://127.0.0.1:7890"
    fees:
      maker_bps: 0.5
      taker_bps: 4.0
    auth:
      # legacy_hmac 模式使用 API key / secret。
      api_key_env: "ASTER_API_KEY"
      api_secret_env: "ASTER_API_SECRET"
      # v3_signer 模式使用主账户地址 + API wallet 私钥。
      # account_address_env: "ASTER_ACCOUNT_ADDRESS"
      # private_key_env: "ASTER_SIGNER_PRIVATE_KEY"
    adapter_options:
      # Aster 同时支持 legacy_hmac 与 v3_signer；默认会按已配置凭证自动判断。
      # trade_auth_mode: "legacy_hmac"
      # trade_auth_mode: "v3_signer"

  # Bybit 目前作为一个独立协议族接入，而不是继续复用 binance_like。
  # 这样做的原因是：Bybit V5 的签名头、REST 路径、订单/持仓字段和 Binance Futures 明显不同。
  bybit:
    adapter_kind: "bybit_v5"
    venue_kind: "bybit"
    enabled: false
    label: "Bybit"
    settle_asset: "USDT"
    rest_base_url: "https://api.bybit.com"
    # Bybit V5 public linear market stream。
    # 当前实现会在这条连接上同时订阅 `tickers.{symbol}` 与 `orderbook.1.{symbol}`：
    # - ticker 负责 funding / mark / index
    # - orderbook.1 负责更细的 top-of-book
    market_ws_base_url: "wss://stream.bybit.com/v5/public/linear"
    # Bybit V5 private order stream 官方入口。
    private_ws_base_url: "wss://stream.bybit.com/v5/private"
    request_timeout: 10s
    default_funding_interval_hours: 8
    proxy:
      enabled: false
      url: "http://127.0.0.1:7890"
    fees:
      maker_bps: 1.0
      taker_bps: 5.5
    auth:
      api_key_env: "BYBIT_API_KEY"
      api_secret_env: "BYBIT_API_SECRET"
      # broker 用户如需附加 X-Referer，可通过 extra_env 传入。
      # extra_env:
      #   referer: "BYBIT_REFERER"
    adapter_options:
      # Bybit V5 当前默认按 linear perpetual 工作。
      category: "linear"
      # 统一账户默认走 UNIFIED；如你的账户模型不同，可在这里覆盖。
      account_type: "UNIFIED"

  hyperliquid:
    adapter_kind: "hyperliquid"
    venue_kind: "hyperliquid"
    enabled: true
    label: "Hyperliquid"
    settle_asset: "USDC"
    rest_base_url: "https://api.hyperliquid.xyz"
    market_ws_base_url: "wss://api.hyperliquid.xyz/ws"
    public_ws_base_url: "wss://api.hyperliquid.xyz/ws"
    request_timeout: 10s
    default_funding_interval_hours: 1
    proxy:
      enabled: false
      url: "http://127.0.0.1:7890"
    fees:
      maker_bps: 1.5
      taker_bps: 4.5
    auth:
      # 私钥环境变量名（用于签名下单）。
      private_key_env: "HYPERLIQUID_PRIVATE_KEY"
      # 主账户地址环境变量名。
      account_address_env: "HYPERLIQUID_ACCOUNT_ADDRESS"
      # Vault 地址环境变量名（如使用金库模式）。
      vault_address_env: "HYPERLIQUID_VAULT_ADDRESS"
