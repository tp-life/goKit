app:
  name: "my-high-perf-service"
  version: "v1.0.0"

web:
  port: ":8080"
  app_name: "MyAPI"
  prefork: false

rpc:
  port: ":9090"
  max_connection_idle: 300s
  timeout: 5s

database:
  driver: "mysql"
  # 请修改为你的实际数据库地址
  dsn: "root:root@tcp(127.0.0.1:3306)/my_db?charset=utf8mb4&parseTime=True&loc=Local"
  replicas: []
  max_idle_conns: 10
  max_open_conns: 100
  log_mode: "info"
  # 启动时用 Gorm AutoMigrate 自动同步 sys_* 表结构（仅限开发/简单部署，生产建议关闭）
  auto_migrate: true
  # 启动时执行 migrations/ 内嵌的版本化迁移（生产推荐）；
  # 与 auto_migrate 同开时优先生效，auto_migrate 不再执行
  migrations_enabled: false

jwt:
  # 生产环境务必修改为强随机值；微服务模式下所有服务必须共享同一 secret
  secret: "please-change-me-in-production"
  issuer: "gokit"
  expire_minutes: 120

authz:
  # local  → 单机模式：进程内直接校验权限（默认）
  # remote → 微服务模式：通过 gRPC 调用系统服务做权限校验
  mode: "local"
  # remote 模式下系统服务的 gRPC 地址
  addr: "127.0.0.1:9090"
  # 服务间共享密钥：非空时系统服务 gRPC 启用 Bearer 认证，
  # 业务服务的远程客户端必须携带同一 token；留空表示不启用（仅限内网可信环境）
  token: ""

seed:
  # 首次启动播种 admin 账号 / 内置角色 / 菜单权限树（admin 已存在则跳过）
  enabled: true

rate_limit:
  # 登录接口限流（按客户端 IP，进程内计数）
  login_max: 10      # 窗口内最大尝试次数
  login_window: 1m   # 限流窗口

trace:
  # OTLP gRPC 上报地址（如 "otel-collector:4317"），留空则不启用链路追踪
  endpoint: ""
  service_name: "gokit"
  # 采样率 0~1
  sample_ratio: 1.0
