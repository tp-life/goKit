app:
  name: "crypto-arbitrage-monitor"
  version: "v1.0.0"

web:
  port: ":8080"
  app_name: "Arbitrage Monitor"
  prefork: false

rpc:
  port: ":9090"
  max_connection_idle: 300s
  timeout: 5s

database:
  driver: "sqlite"
  dsn: "file:data/arbitrage.db?cache=shared&_journal_mode=WAL"
  max_idle_conns: 5
  max_open_conns: 10
  log_mode: "info"
  slow_threshold: 200ms

log:
  level: "info"
  format: "json"
  source: false

exchanges:
  binance:
    enabled: true
    spot_ws_url: "wss://stream.binance.com:9443/ws"
    futures_ws_url: "wss://fstream.binance.com/ws"
    rest_url: "https://fapi.binance.com"
    reconnect_interval: 5s
    rate_limit: 1200
    proxy_url: ""  # 可选，如: "socks5://127.0.0.1:1080"
    
  lighter:
    enabled: true
    ws_url: "wss://mainnet.zklighter.elliot.ai/stream"
    rest_url: "https://mainnet.zklighter.elliot.ai/api/v1"
    reconnect_interval: 5s
    rate_limit: 100
    proxy_url: ""
    
  hyperliquid:
    enabled: true
    ws_url: "wss://api.hyperliquid.xyz/ws"
    rest_url: "https://api.hyperliquid.xyz"
    reconnect_interval: 5s
    rate_limit: 100
    proxy_url: ""

arbitrage:
  default_high_threshold: 0.0005    # 0.05%
  default_medium_threshold: 0.0002  # 0.02%
  min_profitability: 0.0001         # 0.01%
  max_single_position: 10000
  max_total_position: 50000
  max_execution_time: 30s
  price_update_interval: 3s
  rate_update_interval: 60s
  
  symbols:
    - symbol: "BTCUSDC"
      binance_market: "BTCUSDC"
      lighter_market_id: 1
      hyperliquid_market: "BTC"
      enabled: true
    - symbol: "ETHUSDC"
      binance_market: "ETHUSDC"
      lighter_market_id: 0
      hyperliquid_market: "ETH"
      enabled: true

trading:
  enabled: false  # 当前禁用，后续启用
  # API 密钥从环境变量读取:
  # BINANCE_API_KEY, BINANCE_API_SECRET
  # LIGHTER_API_KEY, LIGHTER_API_SECRET
  # HYPERLIQUID_API_KEY, HYPERLIQUID_API_SECRET
